#!/bin/sh
# geex <%= @version %>: start the release this file is in (ADR-0041 §2).
#
# ~/.local/bin/geex is a symlink to this file, so the real file is found first, and the release
# is the directory above it. Then the VM replaces this shell: erlexec starts beam.smp, every
# module loads at boot (`-mode embedded`), and the arguments after `-extra` are geex's own
# (`Geex.CLI`). `-geex standalone true` tells geex it is the installed program, not `mix run`.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=${self%/*}/$link ;;
  esac
done
case $self in
  */*) dir=${self%/*} ;;
  *) dir=. ;;
esac
root=$(cd "$dir/.." && pwd -P) || exit 1
rel=$root/releases/<%= @version %>

ROOTDIR=$root
BINDIR=$root/erts-<%= @erts %>/bin
EMU=beam
PROGNAME=geex
# Elixir's config provider (config/runtime.exs) finds the release by these two.
RELEASE_ROOT=$root
RELEASE_SYS_CONFIG=$rel/sys
# A VM crash writes its dump beside geex.log, in geex's own 0700 state directory: not into the
# directory geex was started in, and not under a fixed name in a shared /tmp, where another user
# could plant a symlink for the VM to write through (Geex.state_dir/0 names the same place).
if [ -z "${ERL_CRASH_DUMP:-}" ]; then
  state=${XDG_STATE_HOME:-$HOME/.local/state}/geex
  mkdir -p "$state" 2>/dev/null && chmod 700 "$state" 2>/dev/null
  ERL_CRASH_DUMP=$state/erl_crash.dump
fi
export ROOTDIR BINDIR EMU PROGNAME RELEASE_ROOT RELEASE_SYS_CONFIG ERL_CRASH_DUMP

exec "$BINDIR/erlexec" -noshell -mode embedded \
  -boot "$rel/start" -boot_var RELEASE_LIB "$root/lib" \
  -args_file "$rel/vm.args" -config "$rel/sys.config" \
  -geex standalone true \
  -extra "$@"
